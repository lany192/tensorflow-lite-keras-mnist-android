<?xml version="1.0" encoding="utf-8"?>
<!--
  按年级的统计行。由 HistoryActivity.renderStats() 运行时 inflate 进 containerStats。

  android:id 与文本格式由 Kotlin 侧写入（history_grade_stat_format），改这里的结构前先看那边。
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/textGradeStat"
    style="@style/TextAppearance.App.Body"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_sm"
    android:background="@drawable/bg_block"
    android:paddingStart="@dimen/space_lg"
    android:paddingTop="@dimen/space_md"
    android:paddingEnd="@dimen/space_lg"
    android:paddingBottom="@dimen/space_md"
    tools:text="四年级　答对 34/40" />
